<!DOCTYPE html>
<html lang="zh-TW">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>資產配置與記帳簿</title>
  <style>
    :root {
      --primary: #1e3a8a;
      --bg: #f8fafc;
      --card-bg: #ffffff;
      --text: #0f172a;
      --text-sub: #64748b;
      --border: #e2e8f0;
      --danger: #ef4444;
      --warning: #f59e0b;
      --success: #10b981;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }
    body { background: var(--bg); color: var(--text); padding: 16px; padding-bottom: 80px; }
    .container { max-width: 480px; margin: 0 auto; }
    
    .summary-card {
      background: var(--card-bg);
      border-radius: 16px;
      padding: 20px;
      margin-bottom: 16px;
      border: 1px solid var(--border);
      box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05);
    }
    .summary-card .label { font-size: 14px; color: var(--text-sub); }
    .summary-card .val-large { font-size: 30px; font-weight: 800; color: var(--primary); margin: 6px 0 12px; }
    .summary-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; border-top: 1px solid var(--border); padding-top: 12px; }
    .summary-grid .sub-val { font-size: 16px; font-weight: 700; margin-top: 4px; }
    
    .status-banner {
      background: #fffbeb;
      border: 1px solid var(--warning);
      padding: 10px 14px;
      border-radius: 8px;
      font-size: 13px;
      color: #b45309;
      margin-bottom: 16px;
      display: none;
    }

    .btn-group { display: flex; gap: 8px; margin-bottom: 16px; }
    button {
      flex: 1;
      padding: 14px 16px;
      font-size: 15px;
      font-weight: 600;
      border-radius: 10px;
      border: none;
      cursor: pointer;
      display: flex;
      justify-content: center;
      align-items: center;
    }
    .btn-primary { background: var(--primary); color: #fff; }
    .btn-outline { background: #fff; border: 1px solid var(--border); color: var(--text); }
    .btn-danger { background: var(--danger); color: #fff; padding: 6px 10px; font-size: 12px; border-radius: 6px; }
    .btn-edit { background: #f1f5f9; color: var(--text); padding: 6px 10px; font-size: 12px; border-radius: 6px; border: 1px solid var(--border); }

    .control-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 12px;
      gap: 8px;
    }
    .control-row select {
      padding: 8px 12px;
      border-radius: 8px;
      border: 1px solid var(--border);
      background: #fff;
      font-size: 14px;
      font-weight: 600;
    }

    .card {
      background: var(--card-bg);
      border-radius: 12px;
      padding: 16px;
      margin-bottom: 12px;
      border: 1px solid var(--border);
    }
    .item-header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 8px; }
    .item-title { font-size: 17px; font-weight: 700; }
    .item-market { font-size: 12px; padding: 2px 6px; background: #e2e8f0; border-radius: 4px; margin-left: 6px; }
    .item-data { display: flex; justify-content: space-between; margin-top: 6px; font-size: 14px; }
    .item-meta { font-size: 11px; color: var(--text-sub); margin-top: 8px; line-height: 1.4; border-top: 1px dashed var(--border); padding-top: 6px; }

    .badge-warn { color: var(--warning); font-weight: 600; }
    .badge-ok { color: var(--success); font-weight: 700; }
    .badge-muted { color: var(--text-sub); font-weight: 600; }
    .profit-up { color: #dc2626; font-weight: 700; }
    .profit-down { color: #16a34a; font-weight: 700; }

    .modal {
      position: fixed; top: 0; left: 0; right: 0; bottom: 0;
      background: rgba(0,0,0,0.5);
      display: none; justify-content: center; align-items: flex-end; z-index: 99;
    }
    .modal-content {
      background: #fff;
      width: 100%;
      max-width: 480px;
      border-radius: 16px 16px 0 0;
      padding: 24px;
      max-height: 90vh;
      overflow-y: auto;
    }
    .form-group { margin-bottom: 14px; }
    .form-group label { display: block; font-size: 14px; font-weight: 600; margin-bottom: 6px; }
    .form-group input, .form-group select {
      width: 100%; padding: 12px; border: 1px solid var(--border); border-radius: 8px; font-size: 16px;
    }

    .footer-note {
      font-size: 12px;
      color: var(--text-sub);
      text-align: center;
      margin-top: 24px;
      line-height: 1.5;
    }
  </style>
</head>
<body>

<div class="container">
  <div id="statusBanner" class="status-banner"></div>

  <!-- 總覽看板 -->
  <div class="summary-card">
    <div class="label">淨資產 (TWD)</div>
    <div class="val-large" id="netAssetDisplay">$0</div>
    <div class="summary-grid">
      <div>
        <div class="label">總資產</div>
        <div class="sub-val" id="totalAssetDisplay">$0</div>
      </div>
      <div>
        <div class="label">總負債</div>
        <div class="sub-val" id="debtAssetDisplay">$0</div>
      </div>
    </div>
    
    <!-- 預估明年配息與總平均殖利率 -->
    <div class="summary-grid" style="margin-top: 10px;">
      <div>
        <div class="label">預估明年現金配息</div>
        <div class="sub-val badge-ok" id="estimatedDividendDisplay">$0</div>
      </div>
      <div>
        <div class="label">總平均現金殖利率</div>
        <div class="sub-val badge-ok" id="portfolioYieldDisplay">0.00%</div>
      </div>
    </div>

    <!-- 類現金金額與比率 -->
    <div class="summary-grid" style="margin-top: 10px;">
      <div>
        <div class="label">類現金金額 (Beta=0)</div>
        <div class="sub-val" id="cashLikeTotalDisplay">$0</div>
      </div>
      <div>
        <div class="label">類現金佔總資產比率</div>
        <div class="sub-val" id="cashLikeRatioDisplay">0.0%</div>
      </div>
    </div>

    <!-- 組合 Beta 與整體報酬 -->
    <div class="summary-grid" style="margin-top: 10px;">
      <div>
        <div class="label">資產組合加權 Beta</div>
        <div class="sub-val" id="portfolioBetaDisplay">0.00</div>
      </div>
      <div>
        <div class="label">資產整體報酬表現</div>
        <div class="sub-val" id="portfolioReturnDisplay">--</div>
      </div>
    </div>

    <div style="font-size: 11px; color: var(--text-sub); margin-top: 12px;" id="fxRateInfo">
      匯率資訊：載入中...
    </div>
  </div>

  <!-- 操作按鈕 -->
  <div class="btn-group">
    <button class="btn-primary" onclick="refreshQuotes()">更新價格</button>
    <button class="btn-outline" onclick="openModal('addAssetModal')">新增項目</button>
    <button class="btn-outline" onclick="openModal('backupModal')">備份/還原</button>
  </div>

  <!-- 控制列：排序與報酬基準 -->
  <div class="control-row">
    <div>
      <span style="font-size: 13px; color: var(--text-sub);">排序：</span>
      <select id="sortOption" onchange="renderUI()">
        <option value="DEFAULT">預設順序</option>
        <option value="AMOUNT_DESC">金額 (高至低)</option>
        <option value="QTY_DESC">股數 (多至少)</option>
        <option value="MARKET_TW_FIRST">台股優先</option>
        <option value="MARKET_US_FIRST">美股優先</option>
      </select>
    </div>
    <div>
      <span style="font-size: 13px; color: var(--text-sub);">報酬基準：</span>
      <select id="returnBenchmark" onchange="renderUI()">
        <option value="1D">前一日</option>
        <option value="1M">前一個月</option>
        <option value="1Y">前一年</option>
      </select>
    </div>
  </div>

  <!-- 明細列表 -->
  <div id="assetList"></div>

  <div class="footer-note">
    💡 提示：預估配息係依最新殖利率與持股市值推算；若標的無配息政策將明確顯示「不配息」。資料存放於本機瀏覽器，請定期備份。
  </div>
</div>

<!-- 新增資產 Modal -->
<div id="addAssetModal" class="modal">
  <div class="modal-content">
    <h3 style="margin-bottom: 16px;">新增項目</h3>
    <div class="form-group">
      <label>類別</label>
      <select id="itemType" onchange="toggleFormType()">
        <option value="STOCK">股票 / ETF</option>
        <option value="CASH">現金</option>
        <option value="DEBT">負債</option>
      </select>
    </div>

    <!-- 股票欄位 -->
    <div id="stockFields">
      <div class="form-group">
        <label>市場</label>
        <select id="stockMarket">
          <option value="TW">台股 (上市/上櫃)</option>
          <option value="US">美股 (US)</option>
          <option value="HK">港股 (HK)</option>
        </select>
      </div>
      <div class="form-group">
        <label>代號 (例: 00662, QQQ, 2834)</label>
        <input type="text" id="stockSymbol" placeholder="請輸入代號" style="text-transform: uppercase;">
      </div>
      <div class="form-group">
        <label>持有股數 (股)</label>
        <input type="number" step="any" id="stockQty" placeholder="0">
      </div>
    </div>

    <!-- 現金 / 負債欄位 -->
    <div id="fiatFields" style="display: none;">
      <div class="form-group">
        <label>幣別</label>
        <select id="fiatCurrency">
          <option value="TWD">新台幣 (TWD)</option>
          <option value="USD">美元 (USD)</option>
          <option value="HKD">港幣 (HKD)</option>
        </select>
      </div>
      <div class="form-group">
        <label>金額</label>
        <input type="number" step="any" id="fiatAmount" placeholder="0">
      </div>
    </div>

    <div class="btn-group" style="margin-top: 20px;">
      <button class="btn-outline" onclick="closeModal('addAssetModal')">取消</button>
      <button class="btn-primary" onclick="saveItem()">儲存</button>
    </div>
  </div>
</div>

<!-- 修改數量 Modal -->
<div id="editQtyModal" class="modal">
  <div class="modal-content">
    <h3 style="margin-bottom: 16px;">修改持有數量</h3>
    <input type="hidden" id="editItemId">
    <div class="form-group">
      <label id="editItemLabel">持有數量</label>
      <input type="number" step="any" id="editItemQty">
    </div>
    <div class="btn-group">
      <button class="btn-outline" onclick="closeModal('editQtyModal')">取消</button>
      <button class="btn-primary" onclick="submitEditQty()">儲存變更</button>
    </div>
  </div>
</div>

<!-- 手動補登價格與資訊 Modal -->
<div id="manualPriceModal" class="modal">
  <div class="modal-content">
    <h3 style="margin-bottom: 16px;">手動設定價格與指標</h3>
    <input type="hidden" id="manualQuoteKey">
    <div class="form-group">
      <label>收盤價 (原幣)</label>
      <input type="number" step="any" id="manualPriceVal" placeholder="0.00">
    </div>
    <div class="form-group">
      <label>Beta 值 (類現金填 0，大盤填 1.0)</label>
      <input type="number" step="any" id="manualBetaVal" placeholder="例如: 1.15">
    </div>
    <div class="form-group">
      <label>現金殖利率 (%) [不配息請填 0]</label>
      <input type="number" step="any" id="manualYieldVal" placeholder="例如: 4.5">
    </div>
    <div class="form-group">
      <label>價格日期</label>
      <input type="date" id="manualPriceDate">
    </div>
    <div class="btn-group">
      <button class="btn-outline" onclick="closeModal('manualPriceModal')">取消</button>
      <button class="btn-primary" onclick="saveManualPrice()">儲存套用</button>
    </div>
  </div>
</div>

<!-- 備份還原 Modal -->
<div id="backupModal" class="modal">
  <div class="modal-content">
    <h3 style="margin-bottom: 16px;">備份與還原</h3>
    <div class="form-group">
      <button class="btn-primary" style="width: 100%; margin-bottom: 8px;" onclick="exportJSON()">下載 JSON 備份檔</button>
    </div>
    <div class="form-group" style="margin-top: 16px;">
      <label>匯入備份 (覆蓋還原)</label>
      <input type="file" id="importFileInput" accept=".json" onchange="previewImport(event)">
    </div>
    <div id="importPreview" style="font-size: 13px; color: var(--text-sub); margin-bottom: 16px;"></div>
    <div class="btn-group">
      <button class="btn-outline" onclick="closeModal('backupModal')">關閉</button>
      <button id="btnConfirmRestore" class="btn-danger" style="display:none;" onclick="confirmRestore()">確認覆蓋還原</button>
    </div>
  </div>
</div>

<script>
// 【重要】請將此網址替換為您的 Cloudflare Worker 網址
const PROXY_BASE_URL = 'https://asset-tracker-proxy.roseleaf719.workers.dev'; 

const STORAGE_KEY = 'PORTFOLIO_LEDGER_DATA_V4';

let state = {
  assets: [],       
  quotes: {},       
  fxRates: {
    USD: { rate: null, date: null },
    HKD: { rate: null, date: null }
  }
};

let importStagingData = null;

window.addEventListener('DOMContentLoaded', () => {
  loadFromLocal();
  renderUI();
  refreshQuotes(true);
});

function loadFromLocal() {
  const local = localStorage.getItem(STORAGE_KEY);
  if (local) {
    try {
      const parsed = JSON.parse(local);
      state = { ...state, ...parsed };
    } catch (e) {
      console.error("Local data parse error", e);
    }
  }
}

function saveToLocal() {
  localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
}

function toggleFormType() {
  const type = document.getElementById('itemType').value;
  document.getElementById('stockFields').style.display = (type === 'STOCK') ? 'block' : 'none';
  document.getElementById('fiatFields').style.display = (type !== 'STOCK') ? 'block' : 'none';
}

function openModal(id) { document.getElementById(id).style.display = 'flex'; }
function closeModal(id) { document.getElementById(id).style.display = 'none'; }

function saveItem() {
  const type = document.getElementById('itemType').value;
  const id = Date.now().toString();

  if (type === 'STOCK') {
    const market = document.getElementById('stockMarket').value;
    let symbol = document.getElementById('stockSymbol').value.trim().toUpperCase();
    const qty = parseFloat(document.getElementById('stockQty').value);

    if (!symbol || isNaN(qty) || qty <= 0) {
      alert('請填寫有效代號與大於 0 的股數');
      return;
    }
    state.assets.push({ id, type, market, symbol, qty });
  } else {
    const currency = document.getElementById('fiatCurrency').value;
    const amount = parseFloat(document.getElementById('fiatAmount').value);

    if (isNaN(amount) || amount <= 0) {
      alert('請填寫大於 0 的金額');
      return;
    }
    state.assets.push({ id, type, currency, amount });
  }

  saveToLocal();
  closeModal('addAssetModal');
  renderUI();
  refreshQuotes(true);
}

function promptEditQty(id) {
  const item = state.assets.find(a => a.id === id);
  if (!item) return;
  document.getElementById('editItemId').value = id;
  document.getElementById('editItemLabel').innerText = item.type === 'STOCK' ? `${item.symbol} 持有股數` : `${item.currency} 金額`;
  document.getElementById('editItemQty').value = item.type === 'STOCK' ? item.qty : item.amount;
  openModal('editQtyModal');
}

function submitEditQty() {
  const id = document.getElementById('editItemId').value;
  const val = parseFloat(document.getElementById('editItemQty').value);
  if (isNaN(val) || val <= 0) {
    alert('請填寫大於 0 的數值');
    return;
  }
  const item = state.assets.find(a => a.id === id);
  if (item) {
    if (item.type === 'STOCK') item.qty = val;
    else item.amount = val;
    saveToLocal();
    closeModal('editQtyModal');
    renderUI();
  }
}

function deleteItem(id) {
  if (confirm('確定刪除此項目？')) {
    state.assets = state.assets.filter(a => a.id !== id);
    saveToLocal();
    renderUI();
  }
}

function resolveTicker(market, symbol) {
  if (market === 'US') return symbol;
  if (market === 'HK') {
    let clean = symbol.replace(/^0+/, '').padStart(4, '0');
    return `${clean}.HK`;
  }
  if (market === 'TW') {
    if (symbol.endsWith('.TWO') || symbol.endsWith('.TW')) return symbol;
    if (symbol === '00865B' || symbol.startsWith('6')) return `${symbol}.TWO`;
    return `${symbol}.TW`;
  }
  return symbol;
}

// 核心修正：加入時區偏移量精準解析當地交易日
async function fetchQuote(tickerKey) {
  const controller = new AbortController();
  const timeoutId = setTimeout(() => controller.abort(), 10000);

  try {
    const fetchUrl = `${PROXY_BASE_URL}?ticker=${encodeURIComponent(tickerKey)}&_t=${Date.now()}`;
    const res = await fetch(fetchUrl, { 
      signal: controller.signal,
      cache: 'no-store'
    });
    clearTimeout(timeoutId);
    if (!res.ok) throw new Error(`HTTP ${res.status}`);
    const data = await res.json();

    const result = data.chart?.result?.[0];
    if (!result) throw new Error('代號不支援或查無資料');

    const meta = result.meta;
    const timestamps = result.timestamp || [];
    const closes = result.indicators?.quote?.[0]?.close || [];

    let price = null;
    let validTimestamp = null;
    let validIdx = -1;

    // 優先採用 meta 最新正式價格與時間戳
    if (meta.regularMarketPrice !== undefined && meta.regularMarketPrice !== null) {
      price = meta.regularMarketPrice;
      validTimestamp = meta.regularMarketTime || timestamps[timestamps.length - 1];
    }

    // 由後往前尋找最新一筆有效收盤價
    for (let i = closes.length - 1; i >= 0; i--) {
      if (closes[i] !== null && closes[i] !== undefined) {
        if (price === null) {
          price = closes[i];
          validTimestamp = timestamps[i];
        }
        validIdx = i;
        break;
      }
    }

    if (price === null) throw new Error('無收盤價格資料');

    // 精準日期計算：使用交易所時區偏移量 (gmtoffset)，精準得到當地交易日（例如美東 9/22）
    const gmtOffset = meta.gmtoffset !== undefined ? meta.gmtoffset : 0;
    const localMs = (validTimestamp + gmtOffset) * 1000;
    const localDate = new Date(localMs);
    const y = localDate.getUTCFullYear();
    const m = String(localDate.getUTCMonth() + 1).padStart(2, '0');
    const d = String(localDate.getUTCDate()).padStart(2, '0');
    const tradeDate = `${y}-${m}-${d}`;

    // 歷史基準價格提取 (前日、前月、前年)
    let prev1dPrice = null;
    let prev1mPrice = null;
    let prev1yPrice = null;

    if (validIdx > 0) {
      for (let i = validIdx - 1; i >= 0; i--) {
        if (closes[i] !== null && closes[i] !== undefined) {
          prev1dPrice = closes[i];
          break;
        }
      }
      const idx1m = Math.max(0, validIdx - 21);
      prev1mPrice = closes[idx1m] ?? prev1dPrice;
      const idx1y = 0;
      prev1yPrice = closes[idx1y] ?? prev1dPrice;
    }

    const oldQuote = state.quotes[tickerKey] || {};
    let finalBeta = oldQuote.isManual && oldQuote.beta !== null ? oldQuote.beta : (data.extractedBeta ?? oldQuote.beta ?? null);
    let finalYield = oldQuote.isManual && oldQuote.divYield !== null ? oldQuote.divYield : (data.extractedYield ?? oldQuote.divYield ?? null);

    return {
      price: Number(price.toFixed(3)),
      prev1dPrice,
      prev1mPrice,
      prev1yPrice,
      beta: finalBeta,
      divYield: finalYield,
      currency: meta.currency || (tickerKey.endsWith('.HK') ? 'HKD' : tickerKey.endsWith('.TW') || tickerKey.endsWith('.TWO') ? 'TWD' : 'USD'),
      date: tradeDate,
      name: meta.shortName || meta.symbol || tickerKey,
      source: 'Yahoo Finance',
      updatedAt: new Date().toLocaleTimeString(),
      error: null,
      isManual: false
    };
  } catch (err) {
    clearTimeout(timeoutId);
    throw err;
  }
}

async function fetchExchangeRates() {
  const controller = new AbortController();
  const timeout = setTimeout(() => controller.abort(), 6000);
  try {
    const res = await fetch(`https://open.er-api.com/v6/latest/USD?_t=${Date.now()}`, { 
      signal: controller.signal,
      cache: 'no-store'
    });
    clearTimeout(timeout);
    if (!res.ok) throw new Error('匯率服務連線失敗');
    const data = await res.json();
    const twdRate = data.rates.TWD;
    const hkdRate = data.rates.HKD;
    const dateStr = data.time_last_update_utc ? new Date(data.time_last_update_utc).toISOString().split('T')[0] : new Date().toISOString().split('T')[0];

    state.fxRates.USD = { rate: twdRate, date: dateStr };
    state.fxRates.HKD = { rate: twdRate / hkdRate, date: dateStr };
  } catch (e) {
    clearTimeout(timeout);
    console.warn("匯率更新失敗", e);
  }
}

async function refreshQuotes(silent = false) {
  if (!silent) {
    document.getElementById('statusBanner').style.display = 'block';
    document.getElementById('statusBanner').innerText = '正在背景抓取行情、Beta、殖利率與匯率...';
  }

  await fetchExchangeRates();

  const stockAssets = state.assets.filter(a => a.type === 'STOCK');
  const uniqueTickers = [...new Set(stockAssets.map(a => resolveTicker(a.market, a.symbol)))];

  const promises = uniqueTickers.map(async (ticker) => {
    try {
      const q = await fetchQuote(ticker);
      state.quotes[ticker] = q;
    } catch (err) {
      if (state.quotes[ticker] && state.quotes[ticker].price) {
        state.quotes[ticker].error = `更新失敗 (${err.message}) - 尚未更新 (保留前次數據)`;
      } else {
        state.quotes[ticker] = {
          price: null,
          beta: null,
          divYield: null,
          error: `查無資料或代號不支援 (${err.message})`,
          updatedAt: new Date().toLocaleTimeString()
        };
      }
    }
  });

  await Promise.all(promises);
  saveToLocal();
  renderUI();
}

function promptManualPrice(ticker) {
  document.getElementById('manualQuoteKey').value = ticker;
  const current = state.quotes[ticker] || {};
  document.getElementById('manualPriceVal').value = current.price || '';
  document.getElementById('manualBetaVal').value = (current.beta !== null && current.beta !== undefined) ? current.beta : '';
  document.getElementById('manualYieldVal').value = (current.divYield !== null && current.divYield !== undefined) ? current.divYield : '';
  document.getElementById('manualPriceDate').value = current.date || new Date().toISOString().split('T')[0];
  openModal('manualPriceModal');
}

function saveManualPrice() {
  const ticker = document.getElementById('manualQuoteKey').value;
  const price = parseFloat(document.getElementById('manualPriceVal').value);
  const betaInput = document.getElementById('manualBetaVal').value;
  const yieldInput = document.getElementById('manualYieldVal').value;
  const date = document.getElementById('manualPriceDate').value;

  if (isNaN(price) || price <= 0 || !date) {
    alert('請填寫正確收盤價與日期');
    return;
  }

  let curr = 'USD';
  if (ticker.endsWith('.TW') || ticker.endsWith('.TWO')) curr = 'TWD';
  if (ticker.endsWith('.HK')) curr = 'HKD';

  state.quotes[ticker] = {
    ...(state.quotes[ticker] || {}),
    price: price,
    beta: betaInput !== '' ? parseFloat(betaInput) : null,
    divYield: yieldInput !== '' ? parseFloat(yieldInput) : null,
    currency: curr,
    date: date,
    source: '手動輸入',
    updatedAt: new Date().toLocaleTimeString(),
    error: null,
    isManual: true
  };

  saveToLocal();
  closeModal('manualPriceModal');
  renderUI();
}

function convertToTWD(amount, currency) {
  if (currency === 'TWD') return amount;
  if (currency === 'USD') return state.fxRates.USD.rate ? amount * state.fxRates.USD.rate : null;
  if (currency === 'HKD') return state.fxRates.HKD.rate ? amount * state.fxRates.HKD.rate : null;
  return null;
}

function renderUI() {
  const listEl = document.getElementById('assetList');
  listEl.innerHTML = '';

  let totalAssetTWD = 0;
  let totalDebtTWD = 0;
  let cashLikeTWD = 0; 
  let weightedBetaSum = 0;
  let portfolioRefTWD = 0;
  let totalEstimatedDividendTWD = 0;

  let hasIncomplete = false;
  let hasMissingBeta = false;
  let missingReasons = [];

  // 匯率顯示
  const fxInfoEl = document.getElementById('fxRateInfo');
  if (state.fxRates.USD.rate && state.fxRates.HKD.rate) {
    fxInfoEl.innerText = `匯率 (${state.fxRates.USD.date} / ExchangeRate-API)：1 美元 = ${state.fxRates.USD.rate.toFixed(2)} 台幣 | 1 港幣 = ${state.fxRates.HKD.rate.toFixed(2)} 台幣`;
  } else {
    fxInfoEl.innerText = `匯率：待補或連線中`;
    hasIncomplete = true;
    missingReasons.push('缺少即時匯率');
  }

  const sortOpt = document.getElementById('sortOption').value;
  const benchmarkOpt = document.getElementById('returnBenchmark').value;

  // 計算每筆項目資料並支援排序
  const enrichedAssets = state.assets.map(item => {
    let valTWD = null;
    let quote = null;
    let refPrice = null;
    let profitTWD = null;
    let profitRate = null;
    let estDivTWD = 0;

    if (item.type === 'STOCK') {
      const ticker = resolveTicker(item.market, item.symbol);
      quote = state.quotes[ticker] || {};
      if (quote.price !== null && quote.price !== undefined) {
        valTWD = convertToTWD(item.qty * quote.price, quote.currency);

        if (benchmarkOpt === '1D') refPrice = quote.prev1dPrice;
        else if (benchmarkOpt === '1M') refPrice = quote.prev1mPrice;
        else if (benchmarkOpt === '1Y') refPrice = quote.prev1yPrice;

        if (refPrice !== null && refPrice !== undefined && valTWD !== null) {
          const refTWD = convertToTWD(item.qty * refPrice, quote.currency);
          if (refTWD !== null) {
            profitTWD = valTWD - refTWD;
            profitRate = ((quote.price - refPrice) / refPrice) * 100;
          }
        }

        if (quote.divYield && quote.divYield > 0 && valTWD !== null) {
          estDivTWD = valTWD * (quote.divYield / 100);
        }
      }
    } else {
      valTWD = convertToTWD(item.amount, item.currency);
    }
    return { ...item, valTWD, quote, profitTWD, profitRate, refPrice, estDivTWD };
  });

  // 排序
  enrichedAssets.sort((a, b) => {
    if (sortOpt === 'AMOUNT_DESC') return (b.valTWD || 0) - (a.valTWD || 0);
    if (sortOpt === 'QTY_DESC') return (b.qty || b.amount || 0) - (a.qty || a.amount || 0);
    if (sortOpt === 'MARKET_TW_FIRST') {
      if (a.market === 'TW' && b.market !== 'TW') return -1;
      if (a.market !== 'TW' && b.market === 'TW') return 1;
    }
    if (sortOpt === 'MARKET_US_FIRST') {
      if (a.market === 'US' && b.market !== 'US') return -1;
      if (a.market !== 'US' && b.market === 'US') return 1;
    }
    return 0;
  });

  // 統計總額、類現金與配息
  enrichedAssets.forEach(item => {
    if (item.valTWD !== null) {
      if (item.type === 'STOCK') {
        totalAssetTWD += item.valTWD;
        totalEstimatedDividendTWD += (item.estDivTWD || 0);

        const beta = item.quote?.beta;
        if (beta !== null && beta !== undefined && !isNaN(beta)) {
          weightedBetaSum += item.valTWD * beta;
          if (Number(beta) === 0) {
            cashLikeTWD += item.valTWD;
          }
        } else {
          hasMissingBeta = true;
        }

        if (item.profitTWD !== null) {
          portfolioRefTWD += (item.valTWD - item.profitTWD);
        } else {
          portfolioRefTWD += item.valTWD;
        }
      } else if (item.type === 'CASH') {
        totalAssetTWD += item.valTWD;
        cashLikeTWD += item.valTWD;
        portfolioRefTWD += item.valTWD;
      } else if (item.type === 'DEBT') {
        totalDebtTWD += item.valTWD;
      }
    } else {
      hasIncomplete = true;
      missingReasons.push(`${item.symbol || item.currency} 資料不全`);
    }
  });

  // 卡片渲染
  enrichedAssets.forEach(item => {
    const card = document.createElement('div');
    card.className = 'card';

    if (item.type === 'STOCK') {
      const ticker = resolveTicker(item.market, item.symbol);
      const quote = item.quote;
      const price = quote?.price;
      const beta = quote?.beta;
      const divYield = quote?.divYield;
      const currency = quote?.currency || (item.market === 'TW' ? 'TWD' : item.market === 'HK' ? 'HKD' : 'USD');
      const valTWD = item.valTWD;

      // 殖利率防呆
      let yieldDisplay = '<span class="badge-warn">待補</span>';
      if (divYield !== null && divYield !== undefined) {
        if (Number(divYield) === 0) {
          yieldDisplay = '<span class="badge-muted">不配息 (0.00%)</span>';
        } else {
          yieldDisplay = `<strong class="badge-ok">${divYield.toFixed(2)}%</strong>`;
        }
      }

      // 報酬率顯示
      let profitDisplay = '<span style="color:var(--text-sub);">無基準資料</span>';
      if (item.profitTWD !== null && item.profitRate !== null) {
        const sign = item.profitTWD >= 0 ? '+' : '';
        const colorClass = item.profitTWD >= 0 ? 'profit-up' : 'profit-down';
        profitDisplay = `<span class="${colorClass}">${sign}$${Math.round(item.profitTWD).toLocaleString()} (${sign}${item.profitRate.toFixed(2)}%)</span>`;
      }

      const ratioDisplay = (totalAssetTWD > 0 && valTWD !== null) ? ` (${((valTWD / totalAssetTWD) * 100).toFixed(1)}%)` : '';
      const estDivDisplay = item.estDivTWD > 0 ? `約 $${Math.round(item.estDivTWD).toLocaleString()} TWD` : '無';

      card.innerHTML = `
        <div class="item-header">
          <div>
            <span class="item-title">${item.symbol}</span>
            <span class="item-market">${item.market}</span>
            <span style="font-size:12px; color:var(--text-sub);">${quote?.name ? `(${quote.name})` : ''}</span>
          </div>
          <div style="display:flex; gap:6px;">
            <button class="btn-edit" onclick="promptEditQty('${item.id}')">修正股數</button>
            <button class="btn-danger" onclick="deleteItem('${item.id}')">刪除</button>
          </div>
        </div>
        <div class="item-data">
          <span>持有股數：${item.qty.toLocaleString()} 股</span>
          <span>收盤價：${price !== null && price !== undefined ? `${price}${currency}` : '<span class="badge-warn">待補</span>'}</span>
        </div>
        <div class="item-data">
          <span>Beta (5年平均)：${beta !== null && beta !== undefined ? `<strong>${beta}</strong>` : '<span class="badge-warn">待補</span>'}</span>
          <span>現金殖利率：${yieldDisplay}</span>
        </div>
        <div class="item-data">
          <span>預估明年配息：</span>
          <span><strong>${estDivDisplay}</strong></span>
        </div>
        <div class="item-data">
          <span>較${benchmarkOpt === '1D' ? '前一日' : benchmarkOpt === '1M' ? '前一個月' : '前一年'}：</span>
          <span>${profitDisplay}</span>
        </div>
        <div class="item-data" style="font-weight:700; font-size:15px; margin-top:8px;">
          <span>市值 (TWD)：</span>
          <span>${valTWD !== null ? `$${Math.round(valTWD).toLocaleString()}<span style="font-size:12px; font-weight:normal; color:var(--text-sub);">${ratioDisplay}</span>` : '<span class="badge-warn">無法估算</span>'}</span>
        </div>
        <div class="item-meta">
          ${price !== null && price !== undefined ? 
            `交易日：${quote.date} | 來源：${quote.source}${quote.isManual ? '(手動)' : ''}<br>更新於：${quote.updatedAt}${quote.error ? `<br><span class="badge-warn">${quote.error}</span>` : ''} · <a href="javascript:void(0)" onclick="promptManualPrice('${ticker}')">手動微調</a>` : 
            `<span class="badge-warn">${quote?.error || '查無收盤價'}</span> <a href="javascript:void(0)" onclick="promptManualPrice('${ticker}')">手動補登</a>`
          }
        </div>
      `;
    } else {
      const valTWD = item.valTWD;
      const isDebt = item.type === 'DEBT';
      const ratioDisplay = (totalAssetTWD > 0 && valTWD !== null && !isDebt) ? ` (${((valTWD / totalAssetTWD) * 100).toFixed(1)}%)` : '';

      card.innerHTML = `
        <div class="item-header">
          <div>
            <span class="item-title">${isDebt ? '負債' : '現金'} (${item.currency})</span>
          </div>
          <div style="display:flex; gap:6px;">
            <button class="btn-edit" onclick="promptEditQty('${item.id}')">修改金額</button>
            <button class="btn-danger" onclick="deleteItem('${item.id}')">刪除</button>
          </div>
        </div>
        <div class="item-data">
          <span>原幣金額：</span>
          <span>${item.amount.toLocaleString()} ${item.currency}</span>
        </div>
        <div class="item-data" style="font-weight:700; font-size:15px;">
          <span>折合 TWD：</span>
          <span>${valTWD !== null ? `$${Math.round(valTWD).toLocaleString()}<span style="font-size:12px; font-weight:normal; color:var(--text-sub);">${ratioDisplay}</span>` : '<span class="badge-warn">缺少匯率</span>'}</span>
        </div>
      `;
    }
    listEl.appendChild(card);
  });

  const banner = document.getElementById('statusBanner');
  if (hasIncomplete) {
    banner.style.display = 'block';
    banner.innerText = `⚠️ 估值不完整：缺少最新價格或匯率（${missingReasons.join(', ')}），總額未完整加總。`;
    document.getElementById('netAssetDisplay').innerHTML = `<span class="badge-warn">估值不完整</span>`;
    document.getElementById('totalAssetDisplay').innerText = `已計：$${Math.round(totalAssetTWD).toLocaleString()}`;
    document.getElementById('debtAssetDisplay').innerText = `$${Math.round(totalDebtTWD).toLocaleString()}`;
    document.getElementById('portfolioBetaDisplay').innerHTML = `<span class="badge-warn">無法計算</span>`;
    document.getElementById('cashLikeRatioDisplay').innerText = `--`;
    document.getElementById('cashLikeTotalDisplay').innerText = `$${Math.round(cashLikeTWD).toLocaleString()}`;
    document.getElementById('estimatedDividendDisplay').innerText = `--`;
    document.getElementById('portfolioYieldDisplay').innerText = `--`;
    document.getElementById('portfolioReturnDisplay').innerText = `--`;
  } else {
    banner.style.display = 'none';
    const net = totalAssetTWD - totalDebtTWD;
    document.getElementById('netAssetDisplay').innerText = `$${Math.round(net).toLocaleString()}`;
    document.getElementById('totalAssetDisplay').innerText = `$${Math.round(totalAssetTWD).toLocaleString()}`;
    document.getElementById('debtAssetDisplay').innerText = `$${Math.round(totalDebtTWD).toLocaleString()}`;
    document.getElementById('cashLikeTotalDisplay').innerText = `$${Math.round(cashLikeTWD).toLocaleString()}`;

    // 顯示預估配息金額與總平均殖利率
    document.getElementById('estimatedDividendDisplay').innerText = `$${Math.round(totalEstimatedDividendTWD).toLocaleString()}`;
    if (totalAssetTWD > 0) {
      const avgYield = (totalEstimatedDividendTWD / totalAssetTWD) * 100;
      document.getElementById('portfolioYieldDisplay').innerText = `${avgYield.toFixed(2)}%`;
    } else {
      document.getElementById('portfolioYieldDisplay').innerText = `0.00%`;
    }

    if (totalAssetTWD > 0) {
      if (hasMissingBeta) {
        document.getElementById('portfolioBetaDisplay').innerHTML = `<span class="badge-warn">Beta不完整</span>`;
      } else {
        const portfolioBeta = weightedBetaSum / totalAssetTWD;
        document.getElementById('portfolioBetaDisplay').innerText = portfolioBeta.toFixed(2);
      }
      
      const cashRatio = (cashLikeTWD / totalAssetTWD) * 100;
      document.getElementById('cashLikeRatioDisplay').innerText = `${cashRatio.toFixed(1)}%`;

      // 總資產報酬表現
      const totalProfit = totalAssetTWD - portfolioRefTWD;
      const totalProfitRate = portfolioRefTWD > 0 ? (totalProfit / portfolioRefTWD) * 100 : 0;
      const sign = totalProfit >= 0 ? '+' : '';
      const colorClass = totalProfit >= 0 ? 'profit-up' : 'profit-down';
      document.getElementById('portfolioReturnDisplay').innerHTML = `<span class="${colorClass}">${sign}$${Math.round(totalProfit).toLocaleString()} (${sign}${totalProfitRate.toFixed(2)}%)</span>`;
    } else {
      document.getElementById('portfolioBetaDisplay').innerText = `0.00`;
      document.getElementById('cashLikeRatioDisplay').innerText = `0.0%`;
      document.getElementById('portfolioReturnDisplay').innerText = `--`;
    }
  }
}

function exportJSON() {
  const blob = new Blob([JSON.stringify(state, null, 2)], { type: 'application/json' });
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url;
  a.download = `portfolio_ledger_backup_${new Date().toISOString().split('T')[0]}.json`;
  a.click();
  URL.revokeObjectURL(url);
}

function previewImport(event) {
  const file = event.target.files[0];
  if (!file) return;

  const reader = new FileReader();
  reader.onload = (e) => {
    try {
      const data = JSON.parse(e.target.result);
      if (!data || !Array.isArray(data.assets)) throw new Error('檔案格式不符，缺少 assets 陣列');
      importStagingData = data;
      const previewEl = document.getElementById('importPreview');
      previewEl.innerText = `檔案驗證通過！內含 ${data.assets.length} 筆資產紀錄。請點擊確認進行還原。`;
      document.getElementById('btnConfirmRestore').style.display = 'block';
    } catch (err) {
      alert(`備份檔案讀取失敗：${err.message}`);
      document.getElementById('importFileInput').value = '';
      document.getElementById('btnConfirmRestore').style.display = 'none';
    }
  };
  reader.readAsText(file);
}

function confirmRestore() {
  if (!importStagingData) return;
  state = importStagingData;
  saveToLocal();
  renderUI();
  closeModal('backupModal');
  alert('資料已成功還原！');
}
</script>
</body>
</html>
